  "confidence": {
    "effort": help.CONFIDENCE_HELP["effort"],
    "complexity": help.CONFIDENCE_HELP["complexity"],
    "placement": help.CONFIDENCE_HELP["placement"],
  },
  "category": help.CATEGORY_HELP,
  "flags": help.FLAG_INFO,
  "sources": help.SOURCE_LABELS,
  "text": help.UI_TEXT,
  "recommendedEngine": recommended_engine,
  "topQueriesPerEntity": top_queries_per_entity,
}|tojson }}</script>

<script nonce="{{ csp_nonce }}">
function showTab(name) {
  document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active') });
  document.querySelectorAll('.nav-links a').forEach(function(a) { a.classList.remove('active') });
  document.getElementById('tab-' + name).classList.add('active');
  document.querySelector('.nav-links a[data-tab="' + name + '"]').classList.add('active');
  window.scrollTo(0, 0);
}
document.querySelectorAll('.nav-links a[data-tab]').forEach(function(link) {
  link.addEventListener('click', function(e) { e.preventDefault(); showTab(this.dataset.tab); });
});
// Entity tables render client-side from embedded JSON. Only the current page of
// rows exists in the DOM, and a row's detail panel is built on first expand —
// this keeps the report responsive for warehouses with tens of thousands of
// entities. All content is inserted via textContent / createElement, never
// parsed as markup, so entity names and SQL from the source project stay inert.
var DATA = JSON.parse(document.getElementById('report-data').textContent);
var HELP = JSON.parse(document.getElementById('help-data').textContent);

// Heavy detail payloads (DDL, load DML, translated SQL) live in separate
// .detail-chunk script tags — inert text until a row in that chunk is expanded.
// Parsed chunks are cached; the script tag's text is released after parse.
var DETAIL_CHUNK_TAGS = {};
document.querySelectorAll('script.detail-chunk').forEach(function(tag) {
  DETAIL_CHUNK_TAGS[tag.dataset.chunk] = tag;
});
var DETAIL_CHUNKS = {};

// ONE formatter for workload figures — the row, the expanded panel, and the
// sidecar pointer all speak the same language ("queries" = executions from
// JOBS logs; "distinct statements" = unique query texts after dedup). Five
// hand-built phrasings had drifted into three different terms for num_shapes
// (2026-08-04 review).
function fmtCount(n) { return Number(n).toLocaleString('en-US'); }
function wlSummary(wl) {
  var q = wl.query_count, ns = wl.num_shapes;
  var base = fmtCount(q) + (q === 1 ? ' query' : ' queries');
  // parenthetical only when dedup actually collapsed something
  if (ns > 0 && ns !== q) base += ' (' + fmtCount(ns) + ' distinct statements)';
  return base + ' · ' + wl.slot_hours + ' slot-hrs';
}
var QUERY_CHUNK_TAGS = {};
document.querySelectorAll('script.query-chunk').forEach(function(tag) {
  QUERY_CHUNK_TAGS[tag.dataset.chunk] = tag;
});
var QUERY_CHUNKS = {};
// Parse ONLY the chunk carrying the expanded entity (e.query_chunk). The old
// walk-all-chunks fallback parsed the entire sample payload on first expand —
// tens of MB at petabyte-scale estates, blocking the main thread.
function getQuerySamples(e) {
  var idx = e.query_chunk;
  if (idx == null) return null;   // entity has no embedded samples
  if (!(idx in QUERY_CHUNKS)) {
    var tag = QUERY_CHUNK_TAGS[idx];
    QUERY_CHUNKS[idx] = tag ? JSON.parse(tag.textContent) : {};
    if (tag) tag.textContent = '';  // free the raw JSON text
  }
  return QUERY_CHUNKS[idx][e.full_name] || null;
}
function detailFor(e) {
  if (e.detail_chunk == null) return e;  // no heavy payload for this entity
  var idx = e.detail_chunk;
  if (!(idx in DETAIL_CHUNKS)) {
    var tag = DETAIL_CHUNK_TAGS[idx];
    DETAIL_CHUNKS[idx] = tag ? JSON.parse(tag.textContent) : {};
    if (tag) tag.textContent = '';  // free the raw JSON text
  }
  var heavy = DETAIL_CHUNKS[idx][e.full_name] || {};
  var merged = Object.create(e);   // prototype view: row fields + heavy fields
  for (var k in heavy) merged[k] = heavy[k];
  return merged;
}

// Engine metadata map — single source of truth for all engine-branching labels and tooltips (Fix 1).
// HELP.recommendedEngine is the global recommended engine; per-entity translated_sql.target_engine
// overrides only for the SQL code block itself.
var SQL_HELP_BASE = "Machine-translated from the BigQuery definition (via sqlglot) as a starting point — validate before production use. ";
var LOAD_DML_BASE = "Athena INSERT statements to load this table's Iceberg target. Chunked tables include idempotent DELETE+INSERT pairs — run chunks sequentially.";
var ENGINE_META = {
  athena: {
    label: "Athena",
    rewriteHeading: "How to rewrite for Athena",
    sqlHelp: SQL_HELP_BASE + "Table references assume the Glue catalog database context.",
    placementTip: "Views are recreated with CREATE VIEW on the recommended Query Engine. Athena cannot create materialized views (use Spark/Glue; Athena reads them) and UDFs require AWS Lambda (USING EXTERNAL FUNCTION) — flagged per entity.",
    loadDmlHelp: LOAD_DML_BASE
  },
  redshift: {
    label: "Redshift",
    rewriteHeading: "How to rewrite for Redshift",
    sqlHelp: SQL_HELP_BASE + "Iceberg table references may need an external schema prefix.",
    placementTip: "Views and materialized views can live inside Redshift (engine-local, full dialect, auto-refresh) or in the shared Iceberg catalog (queryable by Athena, Redshift, and Spark). UDFs must be engine-local.",
    loadDmlHelp: LOAD_DML_BASE + " Athena performs the one-time data load regardless of the recommended Query Engine — Redshift queries the loaded Iceberg tables via an external schema."
  }
};
var RECOMMENDED_ENGINE = HELP.recommendedEngine || 'redshift';
var TOP_QUERIES_PER_ENTITY = HELP.topQueriesPerEntity || 5;

function el(tag, className, text) {
  var node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined && text !== null) node.textContent = text;
  return node;
}

function fmtSize(gb) {
  if (gb == null) return '—';
  if (gb >= 1000000) return (gb / 1000000).toFixed(1) + ' PB';
  if (gb >= 1000) return (gb / 1000).toFixed(1) + ' TB';
  if (gb >= 1) return gb.toFixed(2) + ' GB';
  return Math.round(gb * 1000) + ' MB';
}

function tipSpan(text, tip, className) {
  // Without tip text, render a plain span: an empty data-tip would still pop an
  // empty tooltip bubble and steal keyboard focus.
  if (!tip) return el('span', null, text);
  var s = el('span', (className || 'tip'), text);
  s.setAttribute('tabindex', '0');
  s.setAttribute('data-tip', tip);
  return s;
}

function badge(text, cls, tip) {
  var s = tipSpan(text, tip, 'badge badge-' + cls + ' tip');
  if (!tip) s.className = 'badge badge-' + cls;
  return s;
}

function categoryBadge(cat) {
  return badge(cat, String(cat).toLowerCase(), HELP.category[cat] || '');
}

function flagChip(flag) {
  var info = HELP.flags[flag];
  var label = info ? info[0] : flag.replace(/_/g, ' ');
  var tip = info ? info[1] : flag;
  return badge(label, 'flag', tip);
}

function preCode(text) {
  var p = document.createElement('pre');
  p.appendChild(el('code', null, text));
  return p;
}

function scoreBreakdown(reasoning) {
  var p = el('p', 'text-muted');
  p.style.fontSize = '.8125rem';
  var label = tipSpan('Score breakdown', HELP.text.score_tip);
  label.style.borderBottom = '1px dotted var(--color-text-muted)';
  label.style.cursor = 'help';
  p.appendChild(label);
  p.appendChild(document.createTextNode(': ' + reasoning));
  return p;
}

function flagsParagraph(labelText, flags) {
  var p = el('p');
  p.appendChild(el('strong', null, labelText + ' '));
  flags.forEach(function(f) {
    p.appendChild(flagChip(f));
    p.appendChild(document.createTextNode(' '));
  });
  return p;
}

function sectionHeading(text, tip) {
  var h = el('h3', null, text + ' ');
  h.style.marginTop = '1rem';
  if (tip) h.appendChild(tipSpan('i', tip, 'tip tooltip-icon'));
  return h;
}

function bulletList(items, muted) {
  var ul = el('ul', muted ? 'text-muted' : null);
  ul.style.margin = '.25rem 0';
  ul.style.paddingLeft = '1.25rem';
  items.forEach(function(item) { ul.appendChild(el('li', null, item)); });
  return ul;
}

function buildEffortDetail(e) {
  var td = document.createElement('td');
  td.setAttribute('colspan', '7');
  var eff = e.effort;

  if (eff.reasoning) td.appendChild(scoreBreakdown(eff.reasoning));
  if (eff.flags && eff.flags.length) td.appendChild(flagsParagraph('What to review:', eff.flags));

  if (e.conversion) {
    td.appendChild(sectionHeading('Iceberg DDL (Athena)', 'Generated CREATE TABLE for the Iceberg Storage Target, in Athena engine v3 dialect — Athena creates the tables; Redshift queries them via an external schema. Review flagged type casts and partition decisions before running.'));
    td.appendChild(preCode(e.conversion.ddl));

    var pm = e.conversion.partition_mapping;
    if (pm) {
      var p = el('p');
      p.appendChild(el('strong', null, 'Partitioning: '));
      if (pm.iceberg_transforms && pm.iceberg_transforms.length) {
        p.appendChild(el('code', null, pm.iceberg_transforms.join(', ')));
      } else {
        p.appendChild(document.createTextNode('none'));
      }
      if (pm.sort_order && pm.sort_order.length) {
        p.appendChild(document.createTextNode(' · '));
        p.appendChild(el('strong', null, 'Sort order: '));
        p.appendChild(el('code', null, pm.sort_order.join(', ')));
      }
      p.appendChild(el('span', 'text-muted', pm.auto_derived
        ? HELP.text.partition_auto
        : HELP.text.partition_manual));
      td.appendChild(p);
    }

    var casts = e.conversion.lossy_casts;
    if (casts && casts.length) {
      var cp = el('p');
      cp.appendChild(el('strong', null, 'Type casts that lose information '));
      cp.appendChild(tipSpan('i', 'These columns have no exact Iceberg equivalent, so the mapped type loses precision or range. Confirm each one is acceptable for your data before loading.', 'tip tooltip-icon'));
      td.appendChild(cp);
      var table = document.createElement('table');
      table.style.fontSize = '.8125rem';
      table.style.marginTop = '.25rem';
      var thead = document.createElement('thead');
      var hr = document.createElement('tr');
      ['Column', 'BigQuery Type', 'Iceberg Type', 'Impact'].forEach(function(h) { hr.appendChild(el('th', null, h)); });
      thead.appendChild(hr);
      table.appendChild(thead);
      var tbody = document.createElement('tbody');
      casts.forEach(function(c) {
        var tr = document.createElement('tr');
        var colTd = document.createElement('td');
        colTd.appendChild(el('code', null, c.column));
        tr.appendChild(colTd);
        tr.appendChild(el('td', null, c.source_type));
        tr.appendChild(el('td', null, c.iceberg_type));
        tr.appendChild(el('td', 'text-muted', c.loss_description));
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      td.appendChild(table);
    }

    if (e.conversion.warnings && e.conversion.warnings.length) {
      var wp = el('p');
      wp.appendChild(el('strong', null, 'Warnings:'));
      td.appendChild(wp);
      td.appendChild(bulletList(e.conversion.warnings));
    }
  }

  if (e.storage_placement) {
    var sp = e.storage_placement;
    td.appendChild(sectionHeading('Storage placement', 'Where this entity\'s data lives on AWS. S3 Tables (Iceberg) is the default — open format, queryable by both engines. RMS is a hot-tier exception for type fidelity or sub-second SLA; RMS tables are Redshift-only.'));
    var spP = el('p');
    spP.appendChild(el('strong', null, 'Storage target: '));
    var spLabel = sp.target === 'rms'
      ? 'Redshift Managed Storage (native — two-phase load, see redshift_phase.sql in the migration/ directory)'
      : 'S3 Tables (Iceberg — open, multi-engine)';
    spP.appendChild(document.createTextNode(spLabel));
    td.appendChild(spP);
    if (sp.signals && sp.signals.length) {
      var spWhy = el('p');
      spWhy.appendChild(el('strong', null, 'Why:'));
      td.appendChild(spWhy);
      td.appendChild(bulletList(sp.signals, true));
    }
  }

  if (e.migration_plan) {
    var mp = e.migration_plan;
    td.appendChild(sectionHeading('Load DML (Athena)', ENGINE_META[RECOMMENDED_ENGINE].loadDmlHelp));
    if (mp.statements && mp.statements[0] && mp.statements[0].indexOf('-- TEMPLATE:') === 0) {
      var tb = badge('TEMPLATE — needs dates', 'warning', 'This plan contains placeholder date boundaries. Replace them with actual partition boundaries before running.');
      tb.style.marginBottom = '.5rem';
      td.appendChild(tb);
    }
    var displayLimit = 5;
    var stmts = mp.statements || [];
    for (var si = 0; si < Math.min(stmts.length, displayLimit); si++) {
      td.appendChild(preCode(stmts[si]));
    }
    if (stmts.length > displayLimit) {
      td.appendChild(el('p', 'text-muted', '+ ' + (stmts.length - displayLimit) + ' more statements — see JSON export'));
    }
    if (mp.shortcomings && mp.shortcomings.length) {
      var swp = el('p');
      swp.style.marginTop = '1rem';
      swp.appendChild(el('strong', null, 'Shortcomings:'));
      td.appendChild(swp);
      var sul = el('ul', null);
      sul.style.margin = '.25rem 0';
      sul.style.paddingLeft = '1.25rem';
      sul.style.fontSize = '.8125rem';
      mp.shortcomings.forEach(function(sc) {
        var li = document.createElement('li');
        var catBadge = badge(sc.category.replace(/_/g, ' '), sc.severity === 'action_required' ? 'warning' : 'low');
        li.appendChild(catBadge);
        li.appendChild(document.createTextNode(' ' + sc.description));
        if (sc.remediation) {
          li.appendChild(document.createTextNode(' — '));
          li.appendChild(el('code', null, sc.remediation));
          if (sc.remediation_engine) {
            li.appendChild(el('span', 'text-muted', ' (' + sc.remediation_engine + ')'));
          }
        }
        sul.appendChild(li);
      });
      td.appendChild(sul);
    }
    if (mp.post_optimization && mp.post_optimization.length) {
      var poh = el('p');
      poh.style.marginTop = '1rem';
      poh.appendChild(el('strong', null, 'Post-migration steps:'));
      td.appendChild(poh);
      var pol = el('ul', null);
      pol.style.margin = '.25rem 0';
      pol.style.paddingLeft = '1.25rem';
      pol.style.fontSize = '.8125rem';
      mp.post_optimization.forEach(function(step) {
        var li = document.createElement('li');
        li.appendChild(el('strong', null, step.step_type + ': '));
        li.appendChild(el('code', null, step.command));
        li.appendChild(el('span', 'text-muted', ' (' + step.engine + ') — ' + step.reason));
        pol.appendChild(li);
      });
      td.appendChild(pol);
    }
  }
  return td;
}

function buildQueryDetail(e) {
  var td = document.createElement('td');
  td.setAttribute('colspan', '7');
  var c = e.complexity;

  if (c.reasoning === 'no BigQuery-specific constructs detected') {
    td.appendChild(el('p', 'text-muted', "No BigQuery-specific SQL was found in this entity's definition — it should run on " + ENGINE_META[RECOMMENDED_ENGINE].label + " with little or no change."));
  } else if (c.reasoning && c.reasoning !== 'no SQL surface visible — cannot assess query complexity') {
    td.appendChild(scoreBreakdown(c.reasoning));
  }

  if (c.flags && c.flags.length) td.appendChild(flagsParagraph('What needs attention:', c.flags));

  if (e.depends_on && e.depends_on.length) {
    var dp = el('p');
    dp.appendChild(el('strong', null, 'Reads from: '));
    e.depends_on.forEach(function(dep, i) {
      dp.appendChild(el('span', 'text-muted', dep));
      if (i < e.depends_on.length - 1) dp.appendChild(document.createTextNode(', '));
    });
    td.appendChild(dp);
  }

  if (e.rewrite_guidance && e.rewrite_guidance.length) {
    var engineKey = (e.translated_sql && e.translated_sql.target_engine) || RECOMMENDED_ENGINE;
    td.appendChild(sectionHeading(ENGINE_META[engineKey].rewriteHeading));
    td.appendChild(bulletList(e.rewrite_guidance));
  }

  if (e.translated_sql) {
    var sqlEngineKey = e.translated_sql.target_engine || RECOMMENDED_ENGINE;
    var sqlMeta = ENGINE_META[sqlEngineKey];
    td.appendChild(sectionHeading('Translated ' + sqlMeta.label + ' SQL', sqlMeta.sqlHelp));
    if (e.translated_sql.confidence === 'LOW') {
      var lb = badge('LOW CONFIDENCE', 'low', 'The translator hit constructs it could not fully convert — expect to hand-edit this SQL.');
      lb.style.marginBottom = '.5rem';
      td.appendChild(lb);
    } else if (e.translated_sql.confidence === 'MEDIUM') {
      var mb = badge('AUTO-CONVERTED', 'medium', 'BigQuery-specific constructs (such as timezone conversions) were rewritten automatically. The SQL runs on ' + sqlMeta.label + ', but verify the noted semantics before production use.');
      mb.style.marginBottom = '.5rem';
      td.appendChild(mb);
    }
    if (e.translated_sql.warnings && e.translated_sql.warnings.length) {
      var wl = bulletList(e.translated_sql.warnings, true);
      wl.style.fontSize = '.8125rem';
      td.appendChild(wl);
    }
    td.appendChild(preCode(e.translated_sql.redshift_sql));
  }

  if (e.has_workload && e.query_workload && e.query_workload.num_shapes > 0) {
    var samples = getQuerySamples(e);
    var ns = e.query_workload.num_shapes;
    if (!samples || !samples.length) {
      // Stats without embedded SQL: everything lives in the sidecar.
      td.appendChild(sectionHeading('Production Queries'));
      td.appendChild(el('p', 'text-muted', wlSummary(e.query_workload) + ' — original + translated SQL in query-workload/' + e.full_name + '.sql next to this report.'));
    } else {
      var showing = Math.min(TOP_QUERIES_PER_ENTITY, samples.length);
      td.appendChild(sectionHeading('Production Queries (top ' + showing + ' of ' + fmtCount(ns) + ' distinct statements, by slot cost)'));
      samples.slice(0, TOP_QUERIES_PER_ENTITY).forEach(function(sq, idx) {
        var qDiv = document.createElement('div');
        qDiv.style.marginBottom = '1.5rem';
        qDiv.style.borderBottom = '1px solid var(--color-border)';
        qDiv.style.paddingBottom = '1rem';
        var header = document.createElement('p');
        header.style.margin = '0 0 .5rem';
        header.appendChild(el('strong', null, 'Query ' + (idx + 1)));
        header.appendChild(document.createTextNode(' '));
        var meta = el('span', 'text-muted', '(' + sq.s + ', ' + (sq.m / 3600000).toFixed(1) + ' slot-hrs)');
        meta.style.fontSize = '.8125rem';
        header.appendChild(meta);
        qDiv.appendChild(header);
        var grid = document.createElement('div');
        grid.style.display = 'grid';
        grid.style.gridTemplateColumns = '1fr 1fr';
        grid.style.gap = '12px';
        var origCol = document.createElement('div');
        var origLabel = el('p', 'text-muted', 'BigQuery (original)');
        origLabel.style.margin = '0 0 4px';
        origLabel.style.fontSize = '11px';
        origLabel.style.fontWeight = '600';
        origCol.appendChild(origLabel);
        origCol.appendChild(preCode(sq.o));
        grid.appendChild(origCol);
        var transCol = document.createElement('div');
        var transLabel = el('p', 'text-muted', ENGINE_META[RECOMMENDED_ENGINE].label + ' (translated)');
        transLabel.style.margin = '0 0 4px';
        transLabel.style.fontSize = '11px';
        transLabel.style.fontWeight = '600';
        transCol.appendChild(transLabel);
        transCol.appendChild(preCode(sq.t));
        grid.appendChild(transCol);
        qDiv.appendChild(grid);
        td.appendChild(qDiv);
      });
      // Always point at the sidecar file — when nothing was omitted the
      // pointer previously vanished and readers couldn't find the full set.
      if (ns > TOP_QUERIES_PER_ENTITY) {
        td.appendChild(el('p', 'text-muted', fmtCount(ns - TOP_QUERIES_PER_ENTITY) + ' more distinct statements omitted here — all ' + fmtCount(ns) + ' (original + translated) are in query-workload/' + e.full_name + '.sql next to this report.'));
      } else {
        td.appendChild(el('p', 'text-muted', 'All ' + fmtCount(ns) + ' distinct statement' + (ns === 1 ? '' : 's') + ' shown — also in query-workload/' + e.full_name + '.sql next to this report.'));
      }
    }
  }

  if (e.placement) {
    var placementEngineKey = (e.translated_sql && e.translated_sql.target_engine) || RECOMMENDED_ENGINE;
    td.appendChild(sectionHeading('Where should this live?', ENGINE_META[placementEngineKey].placementTip));
    var hp = el('p');
    hp.appendChild(el('strong', null, 'Recommended home: '));
    var homeLabels = {
      'REDSHIFT': 'Redshift (engine-local)',
      'ICEBERG_CATALOG': 'Iceberg catalog (open, multi-engine)',
      'LAMBDA_UDF_REQUIRED': 'Requires AWS Lambda UDF (USING EXTERNAL FUNCTION)',
      'CREATE VIEW': 'Athena CREATE VIEW',
      'UNSUPPORTED': 'Not supported on this Query Engine — see the flagged constructs in this row',
      'UNKNOWN': 'Undetermined — insufficient metadata'
    };
    var homeLabel = homeLabels[e.placement.home] || ('Review required (' + e.placement.home + ')');
    hp.appendChild(document.createTextNode(homeLabel));
    td.appendChild(hp);
    var signals = e.placement.signals || [];
    if (signals.length) {
      var whyP = el('p');
      whyP.appendChild(el('strong', null, 'Why:'));
      td.appendChild(whyP);
      td.appendChild(bulletList(signals, true));
    }
    if (e.placement.home === 'REDSHIFT' && e.entity_type === 'MATERIALIZED_VIEW') {
      var rmsNote = el('p', 'text-muted',
        'Storage note: a Redshift-native materialized view stores its result set in ' +
        'Redshift Managed Storage — its bytes are included in the RMS line of the AWS ' +
        'cost breakdown (sized from the BigQuery MV\'s bytes; refresh churn not modeled).');
      rmsNote.style.fontSize = '.8125rem';
      td.appendChild(rmsNote);
    }
  }
  return td;
}

function nonEmpty(v) {
  // Mirrors Jinja truthiness: empty arrays are falsy (unlike JS).
  return Array.isArray(v) ? v.length > 0 : !!v;
}

// Heavy fields (conversion, migration_plan, translated_sql) live in lazy detail
// chunks — a non-null detail_chunk means at least one of them exists for this row.
function effortHasDetail(e) {
  return !!(e.effort.reasoning || nonEmpty(e.effort.flags) || e.detail_chunk != null || e.storage_placement);
}

function queryHasDetail(e) {
  return !!(e.complexity.score > 0 || nonEmpty(e.complexity.flags) || nonEmpty(e.rewrite_guidance) || e.placement || e.has_translated_sql || e.has_workload);
}

function renderEffortRow(e, tr) {
