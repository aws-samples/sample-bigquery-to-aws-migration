<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'nonce-{{ csp_nonce }}'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Migration Assessment — {{ project_id }}</title>
<style>
{% include '_styles.j2' %}

/* Tab system */
.tab-content { display: none }
.tab-content.active { display: block }
</style>
</head>
<body>

<div class="header">
  <div class="container">
    <div class="header-inner">
      <div class="header-logo">
        <div class="aws-cube">BQ</div>
        <div>
          <h1 style="color:#fff;margin:0;font-size:1.125rem">Migration Assessment</h1>
          <p style="color:rgba(255,255,255,.5);margin:2px 0 0 0;font-size:.75rem">BigQuery &rarr; AWS Lakehouse{% if recommended_engine == 'athena' %} (Athena){% else %} (Redshift){% endif %}</p>
        </div>
      </div>
      <div class="header-meta">
        Project: <strong>{{ project_id }}</strong> &middot;
        {{ generated_at|timestamp }}
      </div>
    </div>
  </div>
</div>

<div class="nav">
  <div class="container">
    <div class="nav-links">
      <a href="#" data-tab="landing" class="active">Summary<span class="sub">&nbsp;</span></a>
      <a href="#" data-tab="effort">Migration Effort<span class="sub">moving your data</span></a>
      <a href="#" data-tab="query">Query Complexity<span class="sub">rewriting your SQL</span></a>
    </div>
  </div>
</div>

{% import '_help.j2' as help %}
<div class="container" style="padding-top: var(--space-xl); padding-bottom: var(--space-xl);">

<noscript>
<div class="alert alert-warning">
  <strong>JavaScript required</strong><br>
  The entity tables need JavaScript. Summary and cost sections still work; for full entity
  data without scripts, use the JSON files generated alongside this report.
</div>
</noscript>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- TAB: LANDING / SUMMARY                                                 -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div id="tab-landing" class="tab-content active">

{% if cost.estimate_basis_level == "LOW" %}
<div class="alert alert-warning">
  <strong>Low Confidence Cost Estimate</strong><br>
  Compute cost estimates are based on incomplete data. See <a href="#assumptions">Assumptions &amp; Methodology</a> below.
</div>
{% endif %}

<div class="section">
  <div class="section-header">
    <h2>Overview</h2>
  </div>

  <div class="row">
    <div class="col-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="card-title">Total Entities</div>
          <div class="stat-value">{{ summary.total_entities }}</div>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="card-title">Tables</div>
          <div class="stat-value">{{ summary.total_tables }}</div>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="card-title">Total Size <span class="tip tooltip-icon" tabindex="0" data-tip="Top: BigQuery logical size (matches your console). Below: projected S3 Tables (Iceberg) footprint{% if storage_basis == 'measured' %} — measured from TABLE_STORAGE{% elif storage_basis == 'mixed' %} — measured where available, {{ pricing.physical_ratio }}x logical elsewhere{% else %} — estimated at {{ pricing.physical_ratio }}x logical{% endif %}.">i</span></div>
          {% set lsize = summary.total_logical_size_gb|fmt_size_split %}
          <div class="stat-value">{{ lsize[0] }} <span style="font-size:.875rem;font-weight:400">{{ lsize[1] }}</span></div>
          <div style="font-size:.75rem;color:var(--color-text-secondary);margin-top:2px">&rarr; <strong>{{ summary.total_size_gb|fmt_size }}</strong> on S3 Tables (Iceberg)</div>
        </div>
      </div>
    </div>
    <div class="col-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="card-title">SQL Surface Confidence <span class="tip tooltip-icon" tabindex="0" data-tip="How much of your actual SQL the tool analyzed. Caps the reliability of all query-complexity ratings.">i</span></div>
          <div class="stat-value">
            <span class="badge badge-{{ summary.sql_surface_confidence|lower }} tip" tabindex="0" data-tip="{{ help.CONFIDENCE_HELP['sql_surface'][summary.sql_surface_confidence] }}" style="font-size:.875rem;padding:5px 14px">
              {{ summary.sql_surface_confidence }}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Migration Readiness -->
{% import '_donut.j2' as charts %}
<div class="section">
  <div class="section-header">
    <h2>Migration Readiness</h2>
  </div>

  <div class="donut-row">
    {{ charts.donut("Migration Effort", [
      {"label": "Auto", "count": summary.effort_counts.AUTO or 0, "color": "green"},
      {"label": "Assisted", "count": summary.effort_counts.ASSISTED or 0, "color": "amber"},
      {"label": "Manual", "count": summary.effort_counts.MANUAL or 0, "color": "red"},
    ]) }}
    {# Scoped to SQL-owning entities (population REBUILT) — the same counts the
       Query Complexity tab shows. summary.complexity_counts spans ALL entities
       (plain tables can score ADAPT via the hub-entity bonus), which made the
       landing donut disagree with the tab it summarizes (2026-08-03 sandbox validation
       review: donut said 68 Adapt / 208, tab said 7 of 7). #}
    {{ charts.donut("Query Complexity (SQL entities)", [
      {"label": "Portable", "count": sql_counts.PORTABLE, "color": "green"},
      {"label": "Adapt", "count": sql_counts.ADAPT, "color": "amber"},
      {"label": "Rewrite", "count": sql_counts.REWRITE, "color": "red"},
    ]) }}
  </div>
</div>

<!-- Cost Comparison -->
<div class="section">
  <div class="section-header">
    <h2>Cost Comparison</h2>
    <span class="section-badge">monthly estimate</span>
  </div>

  {% if cost.bq_pricing_model == 'UNKNOWN' %}
  {# MRI-2a: offline sentinel — pricing data unavailable #}
  <div class="card" style="border-left: 4px solid var(--color-severity-info); margin-bottom: var(--space-md);">
    <div class="card-body">
      <p style="margin:0 0 .5rem 0;font-weight:600">Pricing data unavailable in this bundle</p>
      <p style="margin:0 0 .5rem 0;font-size:.8125rem;color:var(--color-text-secondary)">
        Query Engine cost comparison skipped. The engine recommendation below is signal-based only.
        Re-run with live pricing or <code>--refresh-pricing</code> for cost figures.
      </p>
      {% if cost.recommendation %}
      <p style="margin:0;font-size:.8125rem;color:var(--color-text-secondary)">
        <strong>Engine recommendation (signal-based):</strong> {{ cost.recommendation.recommended_scenario }}
        {% if engine_recommendation and engine_recommendation.override_reason %} — {{ engine_recommendation.override_reason }}{% endif %}
      </p>
      {% endif %}
    </div>
  </div>
  {% else %}
  {# Available or unavailable: both render AWS content (workload-based, valid either way) #}

  {% if not cost.bq_cost_available %}
  {# BigQuery cost unavailable — suppress comparison, render cause-specific notice #}
  <div class="card" style="border-left: 4px solid var(--color-severity-warning); margin-bottom: var(--space-md);">
    <div class="card-body">
      <p style="margin:0 0 .5rem 0;font-weight:600">BigQuery cost could not be estimated for this Source.</p>
      <p style="margin:0 0 .5rem 0;font-size:.8125rem;color:var(--color-text-secondary)">
        {{ cost.bq_cost_unavailable_reason }}
      </p>
      {% set storage_line = namespace(found=None) %}
      {% for ln in cost.bigquery_breakdown %}
        {% if "storage" in ln.label|lower %}
          {% set storage_line.found = ln %}
        {% endif %}
      {% endfor %}
      {% if storage_line.found and storage_line.found.monthly %}
      <p style="margin:0 0 .5rem 0;font-size:.8125rem;color:var(--color-text-muted)">
        For reference, storage alone is approximately {{ storage_line.found.monthly|currency_precise }}/mo — compute could not be determined, so this is <em>not</em> the bill and no AWS savings comparison is shown.
      </p>
      {% endif %}
      <p style="margin:0;font-size:.8125rem;color:var(--color-text-muted)">
        Migration Effort and Query Complexity below are unaffected — they are derived from schema and query analysis, not billing.
      </p>
    </div>
  </div>
  {% else %}
  {# BQ cost available: render cost-hero + savings tiles #}
  <div class="cost-hero">
    <div class="cost-hero__block">
      {# Range basis (STANDARD capacity modelled from slots): show the modelled
         range, not a false point (2026-08-11 MRI-1). Serializer omits None keys
         — .get() avoids Jinja Undefined passing an `is not none` test. #}
      {% set _bq_low = cost.get("bigquery_monthly_low") %}
      <div class="cost-hero__label">{% if cost.bq_cost_basis == "customer_provided" %}BigQuery (customer-provided){% else %}BigQuery (Current){% if _bq_low is not none %}, modelled range{% endif %}{% endif %}</div>
      <div class="cost-hero__value">{% if _bq_low is not none %}{{ _bq_low|currency_precise }} &ndash; {{ cost.bigquery_monthly|currency_precise }}{% else %}{{ cost.bigquery_monthly|currency_precise }}{% endif %}</div>
      <div class="cost-hero__sub">{% for _ln in cost.bigquery_breakdown %}{% if 'capacity' in _ln.label|lower %}{{ _ln.label }}{% endif %}{% endfor %}{% if cost.bq_pricing_model == 'ON_DEMAND' %}On-Demand{% endif %}{% if cost.bq_pricing_region %} &middot; {{ cost.bq_pricing_region }}{% endif %}</div>
    </div>
    <div class="cost-hero__arrow"{% if cost.monthly_delta_low < 0 %} style="color: var(--color-severity-warning);"{% endif %}>
      <svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      {{ cost.monthly_delta_low|savings }}
    </div>
    <div class="cost-hero__block cost-hero__block--aws">
      <div class="cost-hero__label">AWS Lakehouse{% if cost.recommendation %} ({{ cost.recommendation.recommended_scenario }}){% endif %}</div>
      <div class="cost-hero__value" style="color: var(--color-severity-success);">{% if cost.aws_monthly_low == cost.aws_monthly_high %}{{ cost.aws_monthly_low|currency_precise }}{% else %}{{ cost.aws_monthly_low|currency_precise }} &ndash; {{ cost.aws_monthly_high|currency_precise }}{% endif %}</div>
      <div class="cost-hero__sub">{% if cost.aws_pricing_region %}{{ cost.aws_pricing_region }}{% endif %}</div>
    </div>
  </div>

  {# MEDIUM only: the LOW case already shows the page-top warning banner
     pointing at the same Assumptions section — a third repeat adds nothing. #}
  {% if cost.estimate_basis_level == "MEDIUM" %}
  <p style="margin: calc(-1 * var(--space-sm)) 0 var(--space-md); font-size:.75rem; color:var(--color-text-muted); text-align:center;">
    <span class="badge badge-{{ cost.estimate_basis_level|lower }} tip" tabindex="0" data-tip="{{ help.CONFIDENCE_HELP['cost'][cost.estimate_basis_level] }}">{{ cost.estimate_basis_level }}</span>
    confidence estimate &mdash; see <a href="#assumptions">Assumptions &amp; Methodology</a> for basis, key uncertainties, and exclusions.
  </p>
  {% endif %}

  {# Label and color follow the sign — a cost increase must never render as a
     green "Savings" (2026-07-31 sandbox validation). When the delta range straddles
     zero (AWS high bound costs more, low bound saves — the Intelligent-Tiering
     month-1 vs steady-state spread), show both bounds. #}
  {% set _delta_color = "var(--color-severity-success)" if cost.monthly_delta_low >= 0 else "var(--color-severity-warning)" %}
  {% set _straddles = cost.monthly_delta_low < 0 and cost.monthly_delta_high > 0 %}
  {# Range-basis BQ cost (2026-08-11 MRI-1): the low delta is computed against the
     BQ measured minimum — the committable figure — with the upside shown as a
     subtitle instead of a bare point anchored to the modelled upper estimate. #}
  {% set _bq_range_basis = cost.get("bigquery_monthly_low") is not none %}
  <div class="row" style="margin-bottom: var(--space-lg);">
    <div class="col-6">
      <div class="card text-center">
        <div class="card-body">
          <div class="card-title">{% if cost.monthly_delta_low >= 0 %}Monthly Savings{% elif _straddles %}Monthly Cost vs BigQuery{% else %}Monthly Cost Increase{% endif %}</div>
          <div class="fs-3 fw-bold" style="color: {{ _delta_color }};">{{ cost.monthly_delta_low|savings }}</div>
          {% if _straddles %}<div class="text-muted" style="font-size:.75rem">worst case (all storage hot) &mdash; up to {{ cost.monthly_delta_high|savings }} at storage-tiering steady state</div>
          {% elif _bq_range_basis and cost.monthly_delta_high > cost.monthly_delta_low %}<div class="text-muted" style="font-size:.75rem">vs BigQuery measured minimum &mdash; up to {{ cost.monthly_delta_high|savings }} vs the modelled upper estimate</div>{% endif %}
        </div>
      </div>
    </div>
    <div class="col-6">
      <div class="card text-center">
        <div class="card-body">
          <div class="card-title">{% if cost.annual_savings_low >= 0 %}Annual Savings{% elif _straddles %}Annual Cost vs BigQuery{% else %}Annual Cost Increase{% endif %}</div>
          <div class="fs-3 fw-bold" style="color: {{ _delta_color }};">{{ cost.annual_savings_low|savings_annual }}</div>
          {% if _straddles %}<div class="text-muted" style="font-size:.75rem">worst case &mdash; up to {{ cost.annual_savings_high|savings_annual }} at steady state</div>
          {% elif _bq_range_basis and cost.annual_savings_high > cost.annual_savings_low %}<div class="text-muted" style="font-size:.75rem">vs BigQuery measured minimum &mdash; up to {{ cost.annual_savings_high|savings_annual }}</div>{% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}{# end bq_cost_available check — savings tiles above, AWS sections below render for both #}


  {% if cost.aws_scenarios %}
  <h3 style="margin-bottom: var(--space-md);">AWS Deployment Options</h3>
  {% for scenario in cost.aws_scenarios %}
  <details class="scenario{% if scenario.is_recommended %} scenario-recommended{% endif %}{% if scenario.not_recommended_reason %} scenario-demoted{% endif %}"{% if scenario.is_recommended %} open{% endif %}>
    <summary>
      <span class="scenario-row">
        <span class="scenario-label">
          {{ scenario.label }}
          {% if scenario.is_recommended %}<span class="badge badge-high" style="margin-left:.5rem">RECOMMENDED</span>{% endif %}
          {% if scenario.not_recommended_reason %}<span class="badge badge-demoted tip" tabindex="0" style="margin-left:.5rem" data-tip="{{ scenario.not_recommended_reason }}">NOT RECOMMENDED FOR YOUR USAGE</span>{% endif %}
        </span>
        <span class="scenario-cost">{{ scenario.monthly_total|currency_precise }}</span>
        <span class="scenario-delta">
          {# customer_provided is a total-only figure (compute+storage inseparable):
             scenarios shift storage across the BQ/AWS boundary, so deltas against it
             rank scenarios but aren't absolute savings (2026-08-11 MRI-2). #}
          {% set _vs_label = "vs provided BQ total" if cost.bq_cost_basis == "customer_provided" else "cheaper than BQ" %}
          {% set delta = cost.bigquery_monthly - scenario.monthly_total %}
          {% if cost.bq_cost_available and cost.bigquery_monthly > 100 %}
            {% set pct = ((delta / cost.bigquery_monthly) * 100)|round(0)|int %}
            {% if pct >= 1 %}
              <span style="color:var(--color-severity-success)">{{ pct }}% {{ _vs_label }}</span>
            {% endif %}
          {% elif cost.bq_cost_available %}
            {% if delta > 1 %}
              <span style="color:var(--color-severity-success)">{{ delta|savings }} vs BQ</span>
            {% endif %}
          {% endif %}
        </span>
      </span>
    </summary>
    <div class="card">
      <div class="card-body" style="font-size:.8125rem">
        {% if scenario.not_recommended_reason %}<p style="margin:0 0 .5rem 0;font-weight:600;color:var(--color-severity-warning)">{{ scenario.not_recommended_reason }}.</p>{% endif %}
        {% if scenario.justification %}<p style="margin:0 0 .5rem 0;color:var(--color-text-secondary)">{{ scenario.justification }}</p>{% endif %}
        {% if scenario.workload_fit_notes %}
        <ul style="margin:0;padding-left:1.25rem">
          {% for note in scenario.workload_fit_notes %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </div>
  </details>
  {% endfor %}
  {% endif %}

  {% if cost.bq_cost_available %}
  {# BQ breakdown only when cost is available — AWS breakdown renders for both available and unavailable #}
  <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-md);">BigQuery Cost Breakdown</h3>
  <table>
    <thead>
      <tr>
        <th>Line Item</th>
        <th style="text-align:right">Monthly</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
    {% for line in cost.bigquery_breakdown %}
      <tr>
        <td><strong>{{ line.label }}</strong>{% if line.confidence == "LOW" %} <span class="badge badge-low tip" tabindex="0" data-tip="{{ help.CONFIDENCE_HELP['cost'][line.confidence] }}">LOW CONFIDENCE</span>{% endif %}</td>
        {# .get(): the serializer omits None-valued keys, so a range line has NO
           "monthly" key — bare `line.monthly is not none` is Undefined-is-not-none
           = TRUE and rendered "N/A" (Task 5: STANDARD capacity compute is a range). #}
        <td style="text-align:right">
          {% if line.get("monthly") is not none %}
            {{ line.monthly|currency_precise }}
          {% elif line.get("monthly_low") is not none and line.get("monthly_high") is not none %}
            {{ line.monthly_low|currency_precise }} &ndash; {{ line.monthly_high|currency_precise }}
          {% elif line.get("monthly_low") is not none %}
            {{ line.monthly_low|currency_precise }}
          {% else %}
            &ndash;
          {% endif %}
        </td>
        <td class="text-muted">{{ line.source_note }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-md);">AWS Cost Breakdown (Recommended Option)</h3>
  <table>
    <thead>
      <tr>
        <th>Line Item</th>
        <th style="text-align:right">Monthly</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
    {% for line in cost.aws_lines %}
      <tr>
        <td><strong>{{ line.label }}</strong>{% if line.confidence == "LOW" %} <span class="badge badge-low tip" tabindex="0" data-tip="{{ help.CONFIDENCE_HELP['cost'][line.confidence] }}">LOW CONFIDENCE</span>{% endif %}</td>
        {# .get(): the serializer omits None-valued keys, so a range line has NO
           "monthly" key — bare `line.monthly is not none` is Undefined-is-not-none
           = TRUE and rendered "N/A" (2026-07-31 sandbox regression). #}
        <td style="text-align:right">
          {% if line.get("monthly") is not none %}
            {{ line.monthly|currency_precise }}
          {% elif line.get("monthly_low") is not none and line.get("monthly_high") is not none %}
            {{ line.monthly_low|currency_precise }} &ndash; {{ line.monthly_high|currency_precise }}
          {% elif line.get("monthly_low") is not none %}
            {{ line.monthly_low|currency_precise }}
          {% else %}
            &ndash;
          {% endif %}
        </td>
        <td class="text-muted">{{ line.source_note }}</td>
      </tr>
    {% endfor %}
    <tr style="border-top: 2px solid var(--color-border-divider); font-weight:700">
      <td>Total</td>
      <td style="text-align:right">{% if cost.aws_monthly_low == cost.aws_monthly_high %}{{ cost.aws_monthly_low|currency_precise }}{% else %}{{ cost.aws_monthly_low|currency_precise }} &ndash; {{ cost.aws_monthly_high|currency_precise }}{% endif %}</td>
      <td></td>
    </tr>
    </tbody>
  </table>

  {% if cost.storage_tier_breakdown %}
  <h3 style="margin-top: var(--space-lg); margin-bottom: var(--space-md);">S3 Tables Storage — Intelligent-Tiering Derivation</h3>
  <p class="text-muted" style="font-size:.8125rem; margin-bottom: var(--space-sm);">
    Each table's physical bytes are placed into an Intelligent-Tiering tier by its last-modified age &mdash;
    your storage access pattern as observed at assessment time. This table derives the pattern-based
    figure used in the cost comparison; the higher bound in the storage line above is month&nbsp;1 only.
  </p>
  <table>
    <thead>
      <tr>
        <th>Tier</th>
        <th style="text-align:right">Tables</th>
        <th style="text-align:right">Data</th>
        <th style="text-align:right">Rate ($/GB-mo)</th>
        <th style="text-align:right">Monthly</th>
      </tr>
    </thead>
    <tbody>
    {% for row in cost.storage_tier_breakdown %}
      {# .get(): the serializer omits None-valued keys, so absent ≡ none here #}
      <tr{% if row.tier == "total" %} style="border-top: 2px solid var(--color-border-divider); font-weight:700"{% endif %}>
        <td>{{ row.label }}</td>
        <td style="text-align:right">{% if row.get("tables") is not none %}{{ row.tables }}{% else %}&mdash;{% endif %}</td>
        <td style="text-align:right">{% if row.get("gb") is not none %}{{ row.gb|fmt_size }}{% else %}&mdash;{% endif %}</td>
        <td style="text-align:right">{% if row.get("rate") is not none %}${{ row.rate }}{% if row.get("rate_note") %} <span class="text-muted">({{ row.rate_note }})</span>{% endif %}{% endif %}</td>
        <td style="text-align:right">{{ row.monthly|currency_precise }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="text-muted" style="font-size:.75rem; margin-top: var(--space-sm);">
    All tiers serve reads at millisecond latency with no retrieval fees; an accessed file moves back to
    Frequent automatically. The split uses last-modified time as an access proxy &mdash; regularly-read
    tables stay Frequent, and full-table scans re-heat cold files.
  </p>
  {% endif %}
  {% endif %}{# end MRI-2a UNKNOWN guard #}
</div>


<!-- Assumptions -->
<div class="section" id="assumptions">
  <div class="section-header">
    <h2>Assumptions &amp; Methodology</h2>
  </div>

  {% if cost.estimate_basis or cost.pricing_notes %}
  <div class="card" style="border-left: 4px solid var(--color-severity-info); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">How This Estimate Was Priced
        {% if cost.estimate_basis %}<span class="badge badge-{{ cost.estimate_basis_level|lower }} tip" tabindex="0" data-tip="{{ help.CONFIDENCE_HELP['cost'][cost.estimate_basis_level] }}" style="margin-left:.5rem">{{ cost.estimate_basis_level }}</span>{% endif %}
      </h3>
      {% if cost.estimate_basis %}
      <p style="margin-bottom:.5rem;font-size:.8125rem;color:var(--color-text-secondary)">{{ cost.estimate_basis }}</p>
      {% endif %}
      {% if cost.pricing_notes %}
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        {% for note in cost.pricing_notes %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <div class="card" style="border-left: 4px solid var(--color-brand-orange); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Target Architecture</h3>
      <p style="margin-bottom:.5rem;font-size:.8125rem;color:var(--color-text-secondary)">This assessment models the AWS lakehouse as a <strong>decoupled storage + compute</strong> architecture:</p>
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        <li><strong>Storage:</strong> Amazon S3 Tables (managed Apache Iceberg) — a shared storage layer queryable by both Athena and Redshift</li>
        <li><strong>Compute:</strong> Multiple Query Engine options evaluated — Athena (on-demand $5/TB scanned, or Provisioned Capacity), Redshift Serverless (RPU-based with Reservation discounts), and Redshift Provisioned RG Graviton4 (node-based with RI discounts)</li>
        <li><strong>Best-fit selection:</strong> Workload signals (scan volume, concurrency, activity pattern) plus a cost comparison across all options determine the recommendation</li>
      </ul>
    </div>
  </div>

  {% if cost.recommendation and cost.recommendation.workload_profile and cost.recommendation.workload_profile.has_data %}
  <div class="card" style="border-left: 4px solid var(--color-severity-success); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Your Workload Profile (Used for Sizing)</h3>
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        {% set wp = cost.recommendation.workload_profile %}
        <li><strong>Query volume:</strong> {{ "{:,.0f}".format(wp.queries_per_day) }} queries/day ({{ "{:,.0f}".format(wp.total_queries) }} total over {{ wp.lookback_days }} days)</li>
        <li><strong>Data scanned:</strong> {{ "{:,.0f}".format(wp.monthly_scanned_tb) }} TB/month (avg {{ "{:,.0f}".format(wp.avg_bytes_per_query / 1048576) }} MB per query)</li>
        <li><strong>Concurrency:</strong> ~{{ "{:.0f}".format(wp.avg_concurrent_queries) }} avg / ~{{ "{:.0f}".format(wp.peak_concurrent_queries) }} peak concurrent queries</li>
        <li><strong>Active hours:</strong> {{ "{:.0%}".format(wp.active_hour_fraction) }} of hours have active queries</li>
        <li style="font-size:.75rem;color:var(--color-text-tertiary)">Note: Athena (per-TB scanned) and Redshift Serverless (per-second while active) both cost nothing while idle, so your activity pattern drives the serverless-vs-provisioned choice. Fragmented activity slightly favors Athena because Redshift Serverless bills a 60-second minimum per resume, and connection-pool keep-alive queries prevent it from pausing</li>
        <li><strong>Stored data:</strong> {{ wp.total_stored_gb|fmt_size }}</li>
      </ul>
    </div>
  </div>
  {% endif %}

  <div class="card" style="border-left: 4px solid var(--color-severity-warning); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Storage Assumptions</h3>
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        {% set has_rms_line = cost.aws_lines | selectattr("label", "equalto", "Redshift Managed Storage (RMS)") | list | length > 0 %}
        <li><strong>Both engine paths:</strong> S3 Tables (Iceberg) — storage tiered from ${{ pricing.s3_tables_tier1_per_gb }}/GB ({{ pricing.aws_region }}); automatic compaction/maintenance billed separately (per-object + per-GB-processed). Serverless and Provisioned share the same decoupled Iceberg storage layer{% if has_rms_line %} &mdash; except RMS-placed tables and Redshift-native materialized views, whose bytes bill as Redshift Managed Storage (separate line in the breakdown above). If Athena were chosen instead, all bytes would stay on S3 Tables &mdash; the Athena option is priced accordingly{% else %} &mdash; Redshift Managed Storage is not billed in this architecture{% endif %}</li>
        {% if cost.storage_tier_breakdown %}
        <li><strong>Intelligent-Tiering:</strong> files move to Infrequent Access after 30 days without access (${{ pricing.int_ia_per_gb }}/GB) and Archive Instant Access after 90 (${{ pricing.int_aia_per_gb }}/GB), rates {{ pricing.aws_region }} &mdash; per-tier derivation in the cost breakdown above. All tiers serve reads at millisecond latency with no retrieval fees; an accessed file moves back to Frequent automatically. The split uses last-modified time as an access proxy: regularly-read tables stay Frequent, and full-table scans re-heat cold files</li>
        {% endif %}
        {% if storage_basis == "measured" %}
        <li>Storage sized on <strong>measured physical bytes</strong> from BigQuery TABLE_STORAGE &mdash; 1:1 to S3 Tables (both store compressed Parquet)</li>
        <li style="font-size:.75rem;color:var(--color-text-tertiary)">Limitations: TABLE_STORAGE may lag ~1 day for recent changes; clones/snapshots report full size (conservative)</li>
        {% elif storage_basis == "mixed" %}
        <li>Storage sized on <strong>mixed basis</strong> — tables covered by BigQuery TABLE_STORAGE use measured physical bytes (1:1 to S3 Tables); the remainder assumed at {{ pricing.physical_ratio }}&times; logical</li>
        <li style="font-size:.75rem;color:var(--color-text-tertiary)">Limitations: TABLE_STORAGE may lag ~1 day for recent changes; clones/snapshots report full size (conservative)</li>
        {% else %}
        <li>Physical bytes unavailable &mdash; storage sized at <strong>{{ pricing.physical_ratio }}&times; logical</strong> (1 GiB BQ logical &asymp; {{ pricing.physical_ratio }} GiB on S3 Tables; typical Parquet compression)</li>
        <li style="font-size:.75rem;color:var(--color-text-tertiary)">Typical Parquet compression is 2&ndash;5&times;; {{ pricing.physical_ratio }} reflects mid-range columnar compression</li>
        {% endif %}
      </ul>
    </div>
  </div>

  {% if recommended_engine == "redshift" %}
  <div class="card" style="border-left: 4px solid var(--color-severity-warning); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Redshift Performance Features on Iceberg Storage</h3>
      <p style="margin-bottom:.5rem;font-size:.8125rem;color:var(--color-text-secondary)">Querying open Iceberg tables (rather than Redshift Managed Storage) trades some Redshift-native optimizations for multi-engine access and an open format. Set latency expectations accordingly:</p>
      <ul style="margin:0 0 .5rem 0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        <li><strong>Not available on Iceberg:</strong> result caching (sub-second repeated queries), automatic materialized views (AutoMV), automatic query rewrite to MVs, and zone maps / sort keys (block-level scan skipping)</li>
        <li><strong>At parity:</strong> manual materialized views with AUTO REFRESH, full DML (INSERT / UPDATE / DELETE / MERGE on Iceberg v2), and concurrency scaling for reads</li>
      </ul>
      <p style="margin:0;font-size:.75rem;color:var(--color-text-tertiary)">Query pruning on Iceberg relies on partition layout and Parquet row-group statistics. Workloads dominated by repeated dashboard queries will not see result-cache speedups on this architecture.</p>
    </div>
  </div>
  {% endif %}

  <div class="card" style="border-left: 4px solid var(--color-severity-warning); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Compute Pricing Assumptions</h3>
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        <li><strong>Serverless On-Demand:</strong> ${{ pricing.serverless_rpu_hr }}/RPU-hr ({{ pricing.aws_region }}). BQ slot&rarr;RPU ratio: {{ pricing.slot_to_rpu_ratio }} (evidence range 0.06&ndash;0.25)</li>
        <li><strong>Serverless Reserved (1yr, All Upfront):</strong> ~{{ pricing.serverless_1yr_all_upfront_discount_pct }}% discount (${{ pricing.serverless_1yr_all_upfront_rpu_hr }}/RPU-hr). Break-even at ~{{ pricing.serverless_1yr_all_upfront_breakeven_pct }}% utilization</li>
        <li><strong>Serverless Reserved (1yr, No Upfront):</strong> ~{{ pricing.serverless_1yr_no_upfront_discount_pct }}% discount (${{ pricing.serverless_1yr_no_upfront_rpu_hr }}/RPU-hr). Break-even at ~{{ pricing.serverless_1yr_no_upfront_breakeven_pct }}% utilization</li>
        <li><strong>Provisioned On-Demand:</strong> RG Graviton4 &mdash; rg.xlarge @ ${{ pricing.rg_xl_ondemand_hr }}/node-hr, rg.4xlarge @ ${{ pricing.rg_4xl_ondemand_hr }}/node-hr ({{ pricing.aws_region }}); the priced option's node type appears in its scenario row. {{ pricing.hours_per_month }} hours/month</li>
        <li><strong>Provisioned 1yr RI:</strong> ~{{ pricing.ri_1yr_discount_pct }}% discount vs on-demand</li>
        <li><strong>Provisioned 3yr RI:</strong> ~{{ pricing.ri_3yr_discount_pct }}% discount vs on-demand</li>
        <li><strong>Cluster sizing:</strong> based on peak concurrent query load with 1.5 vCPU/query heuristic and 3&times; burst factor</li>
      </ul>
    </div>
  </div>

  {% if cost.key_uncertainties %}
  <div class="card" style="border-left: 4px solid var(--color-severity-neutral); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Key Uncertainties &mdash; Validate Before Committing</h3>
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        {% for note in cost.key_uncertainties %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  {% if cost.scope_notes %}
  <div class="card" style="border-left: 4px solid var(--color-severity-neutral); margin-bottom: var(--space-md);">
    <div class="card-body">
      <h3 style="margin-top:0;font-size:.9375rem">Not Modeled (Both Sides of the Comparison)</h3>
      <ul style="margin:0;padding-left:1.25rem;font-size:.8125rem;color:var(--color-text-secondary)">
        {% for note in cost.scope_notes %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}
</div>


{% if failures %}
<div class="section">
  <div class="section-header">
    <h2>Failures</h2>
    <span class="section-badge">{{ failures|length }} items</span>
