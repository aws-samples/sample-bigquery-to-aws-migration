{# Heavy per-entity payloads (Iceberg DDL, load DML, translated SQL), chunked. Each tag
   stays inert text until a row in the chunk is first expanded — JSON.parse of the main
   report-data blob at page load stays small at 100k+ entity scale. #}
{% for chunk in detail_chunks %}
<script type="application/json" class="detail-chunk" data-chunk="{{ loop.index0 }}">{{ chunk|tojson }}</script>
{% endfor %}
{% for chunk in query_sample_chunks %}
